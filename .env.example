# Local development environment. Copy to .env and adjust.
# Docker Compose (dev) uses these too via env_file.

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/superapp"
POSTGRES_PASSWORD="change-me-for-compose"

# Session/auth secret (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-in-local-env"

# Single-user login (personal app). Change before exposing to the internet.
AUTH_USERNAME="me"
AUTH_PASSWORD="change-me"

# TMDB (themoviedb.org) API key for movie/series metadata. Free signup.
TMDB_API_KEY=""
# ntfy.sh push notifications for airing episodes (optional)
NTFY_URL=""
# Optional: Google Books API key (higher quota than anonymous)
GOOGLE_BOOKS_API_KEY=""
