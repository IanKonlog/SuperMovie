// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  MOVIE
  SERIES
}

enum WatchStatus {
  WANT_TO_WATCH
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
}

// Media module (movies & TV). Future super-app modules get their own models/files.
model MediaItem {
  id           String      @id @default(cuid())
  title        String
  type         MediaType
  status       WatchStatus @default(WANT_TO_WATCH)
  rating       Int?        // 1-10, set when completed (or anytime)
  isFavorite   Boolean     @default(false)
  progressNote String?     // free-form position, e.g. "S2E5" or "1h12m"
  comment      String?
  posterUrl    String?     // for future TMDB/OMDb metadata integration

  // TMDB metadata (null for manually added items)
  tmdbId      Int?
  overview    String?
  releaseDate String? // ISO date, e.g. "2024-05-01"
  voteAverage Float?
  genres      String[]

  seasons MediaSeason[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([type])
  @@index([tmdbId])
}

// Per-season progress for series. Seasons come from TMDB; manual series have none.
model MediaSeason {
  id           String    @id @default(cuid())
  mediaItemId  String
  seasonNumber Int
  episodeCount Int
  watchedCount Int       @default(0)
  mediaItem    MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([mediaItemId, seasonNumber])
}
