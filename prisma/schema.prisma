// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  MOVIE
  SERIES
}

enum WatchStatus {
  WANT_TO_WATCH
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
}

// Media module (movies & TV). Future super-app modules get their own models/files.
model MediaItem {
  id           String      @id @default(cuid())
  title        String
  type         MediaType
  status       WatchStatus @default(WANT_TO_WATCH)
  rating       Int?        // 1-10, set when completed (or anytime)
  isFavorite   Boolean     @default(false)
  progressNote String?     // free-form position, e.g. "S2E5" or "1h12m"
  comment      String?
  posterUrl    String?     // for future TMDB/OMDb metadata integration

  // TMDB metadata (null for manually added items)
  tmdbId      Int?
  overview    String?
  releaseDate String? // ISO date, e.g. "2024-05-01"
  voteAverage Float?
  genres      String[]

  seasons MediaSeason[]
  watchedEpisodes EpisodeWatched[]

  completedAt DateTime? // when the item was marked COMPLETED (Wrapped/year stats)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([type])
  @@index([tmdbId])
}

// Append-only activity feed (adds, ratings, status changes, episode logs).
model ActivityEvent {
  id        String   @id @default(cuid())
  kind      String // added | status | rating | episode | removed | notified
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Books module (module #2 of the super app).
enum BookStatus {
  WANT_TO_READ
  READING
  FINISHED
  ABANDONED
}

model Book {
  id            String     @id @default(cuid())
  title         String
  authors       String[]
  status        BookStatus @default(WANT_TO_READ)
  rating        Int? // 1-10
  googleBooksId String?
  coverUrl      String?
  description   String?
  pageCount     Int?
  currentPage   Int        @default(0)
  publishedDate String?
  completedAt   DateTime? // when the book was marked FINISHED (Wrapped/year stats)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

// Read-only public share links (stats wall).
model ShareToken {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
}

// Recommendations the user dismissed from the "For you" shelf.
model HiddenRecommendation {
  id       String   @id @default(cuid())
  key      String   @unique // "<MOVIE|SERIES>:<tmdbId>"
  hiddenAt DateTime @default(now())
}

// Per-season progress for series. Seasons come from TMDB; manual series have none.
model MediaSeason {
  id           String    @id @default(cuid())
  mediaItemId  String
  seasonNumber Int
  episodeCount Int
  watchedCount Int       @default(0)
  mediaItem    MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([mediaItemId, seasonNumber])
}

// Episode-level watch state. Source of truth; MediaSeason.watchedCount
// is a cache kept in sync inside the same transaction as these rows.
model EpisodeWatched {
  id           String    @id @default(cuid())
  mediaItemId  String
  seasonNumber Int
  episodeNumber Int
  mediaItem    MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([mediaItemId, seasonNumber, episodeNumber])
  @@index([mediaItemId])
}
